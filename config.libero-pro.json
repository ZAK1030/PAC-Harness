{
  "adapter": {
    "factory": "adapters.libero:create",
    "settings": {
      "suite": "libero_spatial_swap",
      "task_id": 0,
      "init_state_id": 0,
      "seed": 0,
      "image_size": 384,
      "chunk_size": 10,
      "settle_steps": 10,
      "calibrated_motion": true,
      "cartesian": {
        "calibrated_direct": true,
        "max_observation_age_s": 600,
        "move_max_steps": 120,
        "arrival_tolerance_m": 0.002,
        "orientation_tolerance_rad": 0.02,
        "safety": {
          "workspace_reference": "tcp",
          "xyz_min": [
            -0.3,
            -0.8,
            -0.1
          ],
          "xyz_max": [
            1.3,
            0.8,
            1.4
          ],
          "coarse_step_m": 0.05,
          "fine_step_m": 0.01,
          "fine_entry_distance_m": 0.05
        },
        "grounding": {
          "sample_radius_px": 1,
          "max_depth_spread_m": 0.02
        }
      },
      "max_steps": 2400
    }
  },
  "models": {
    "planner": {
      "base_url": "https://api-lb.cubence.ai/v1",
      "model": "gpt-6-astra",
      "api_key_env": "OPENAI_API_KEY",
      "timeout_s": 240,
      "max_transport_retries": 2,
      "max_format_repairs": 2,
      "max_tool_rounds": 6,
      "reasoning_effort": "xhigh",
      "wire_api": "responses"
    },
    "detector": {
      "base_url": "https://api-lb.cubence.ai/v1",
      "model": "gpt-6-astra",
      "api_key_env": "OPENAI_API_KEY",
      "timeout_s": 240,
      "max_transport_retries": 2,
      "max_format_repairs": 2,
      "max_tool_rounds": 4,
      "reasoning_effort": "xhigh",
      "wire_api": "responses"
    }
  },
  "run": {
    "max_turns": 400,
    "max_failures": 3
  },
  "to_user": {
    "enabled": false
  },
  "analyzer": {
    "enabled": false,
    "chunk_turns": 4
  }
}
